# Copia este archivo como .env solo para pruebas locales. En NinjaHosting las
# variables se escriben en cPanel → Setup Node.js App (nunca en el código).

# Dirección pública con https. Webpay devuelve al huésped a BASE_URL/pago/retorno.
BASE_URL=https://hostalsantaelena.cl
# Carpeta con la base de datos, fotos, respaldos y la clave de firma. Fuera de public_html.
DATA_DIR=/home/USUARIO/santaelena-data
# 1 detrás de un proxy (cPanel/Passenger, Render). app.cjs lo activa solo.
TRUST_PROXY=1
# Frase larga para las tareas programadas (/tareas/*). Con ella se apagan los relojes internos.
TAREAS_SECRET=
# 1 solo la primera vez: carga habitaciones y políticas reales. Luego se borra.
INICIAR_BASE=
# Webpay Plus: integracion (pruebas) o produccion.
WEBPAY_ENV=integracion
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
# Correos de confirmación con Resend. Sin llave, quedan en cola en el panel.
RESEND_API_KEY=
MAIL_FROM=Hostal Santa Elena <reservas@hostalsantaelena.cl>
# Solo la primera vez: crean el usuario del panel si no existe ninguno. Luego se borran.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Solo para pruebas locales: PAYMENTS=simulado reemplaza Webpay por una pasarela de prueba.
# PAYMENTS=simulado
